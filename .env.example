# Copy to .env for local development: cp .env.example .env
# Never commit .env. Production values come from the host's environment.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=dev-only-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://campusq:campusq@localhost:5432/campusq

# Email. Default prints emails in the runserver terminal. To send real email via
# Brevo (free tier), uncomment and fill in from Brevo > SMTP & API > SMTP. The
# FROM address must be a sender you verified in Brevo (Senders, domains & IPs).
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_EMAIL_HOST=smtp-relay.brevo.com
# DJANGO_EMAIL_PORT=587
# DJANGO_EMAIL_USE_TLS=true
# DJANGO_EMAIL_HOST_USER=your-login@smtp-brevo.com
# DJANGO_EMAIL_HOST_PASSWORD=your-brevo-smtp-key
# DJANGO_DEFAULT_FROM_EMAIL=CampusQ <you@example.com>
